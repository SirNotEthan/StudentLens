# StudentLens Frontend - Production Environment Variables
# Copy this file to .env and update with your actual values

# Backend API URL
# Replace with your actual domain or VPS IP
VITE_API_BASE_URL=https://yourdomain.com/api
VITE_BACKEND_URL=https://yourdomain.com

# For IP-based deployment (no domain):
# VITE_API_BASE_URL=http://123.45.67.89/api
# VITE_BACKEND_URL=http://123.45.67.89

# For local development (uncomment these):
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_BACKEND_URL=http://localhost:5000

# # For production (DigitalOcean App Platform or any unified deployment):
# # Use relative paths since frontend and backend are served from same domain
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=

# For separate deployments (if deploying frontend and backend to different domains):
# VITE_API_BASE_URL=https://your-backend-domain.com/api
# VITE_BACKEND_URL=https://your-backend-domain.com
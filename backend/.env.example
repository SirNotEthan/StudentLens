# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CLIENT_URL=http://localhost:5173
SECURE_COOKIES=false

# Auth/session secrets
JWT_SECRET=change-me
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
SESSION_SECRET=change-me

# Database provider
# Keep as appwrite until the model layer is fully migrated to PostgreSQL.
DATABASE_PROVIDER=appwrite
DATABASE_URL=postgresql://studentlens:studentlens@localhost:5432/studentlens?schema=public

# Appwrite - temporary while migration is in progress
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_POSTS_COLLECTION_ID=posts
APPWRITE_USERS_COLLECTION_ID=users
APPWRITE_COMMENTS_COLLECTION_ID=comments
APPWRITE_BOOKMARKS_COLLECTION_ID=bookmarks
APPWRITE_APPLICATIONS_COLLECTION_ID=writer_applications
APPWRITE_ANALYTICS_COLLECTION_ID=analytics_events
APPWRITE_STORAGE_BUCKET_ID=profile-pictures
APPWRITE_CONTACT_SUBMISSIONS_COLLECTION_ID=contact_submissions

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Redis
REDIS_URL=redis://localhost:6379

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StudentLens" <noreply@studentlens.net>
CONTACT_EMAIL=

# Security
PUZZLE_SECRET=change-me
ADMIN_IP_WHITELIST_ENABLED=false
ADMIN_WHITELIST_IPS=

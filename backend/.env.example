# Backend Environment Variables
# Copy this file to .env and update with your values

# Server Configuration
PORT=5000
NODE_ENV=production

# Appwrite Configuration
# Sign up at https://cloud.appwrite.io and create a project
APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="your-project-id-here"
APPWRITE_API_KEY="your-api-key-here"
APPWRITE_DATABASE_ID="your-database-id-here"
APPWRITE_USERS_COLLECTION_ID="users"
APPWRITE_POSTS_COLLECTION_ID="posts"
APPWRITE_COMMENTS_COLLECTION_ID="comments"
APPWRITE_APPLICATIONS_COLLECTION_ID="writer_applications"

# JWT Configuration
# IMPORTANT: Generate a secure random value for production
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_VALUE
JWT_EXPIRE=7d

# Session Configuration
# IMPORTANT: Generate a secure random value for production
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_VALUE

# Google OAuth (Optional)
# Create OAuth credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://YOUR_DOMAIN_OR_IP/api/auth/google/callback"

# Frontend URL
# Update with your domain or IP address
CLIENT_URL="http://YOUR_DOMAIN_OR_IP"

# Redis Configuration
# For Docker deployment, use: redis://redis:6379
# For local development, use: redis://localhost:6379
REDIS_URL=redis://redis:6379

# Security Configuration
# Set to 'false' to allow HTTP cookies (for initial HTTP-only deployment)
# Set to 'true' or remove this line to require HTTPS (recommended for production)
SECURE_COOKIES=false

# Admin IP Whitelist (Optional)
# Set to 'true' to enable IP whitelist for admin routes
ADMIN_IP_WHITELIST_ENABLED=false
# Comma-separated list of IPs allowed to access admin routes (in addition to localhost)
# Example: ADMIN_WHITELIST_IPS=123.45.67.89,98.76.54.32
# ADMIN_WHITELIST_IPS=

# Logging (Optional)
# LOG_LEVEL=info

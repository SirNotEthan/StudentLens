# Frontend Environment Variables
# Copy this file to .env and update with your values

# Backend API URL
# For local development:
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_BACKEND_URL=http://localhost:5000

# For production (update with your domain or IP):
VITE_API_BASE_URL=http://YOUR_DOMAIN_OR_IP/api
VITE_BACKEND_URL=http://YOUR_DOMAIN_OR_IP

# If using HTTPS:
# VITE_API_BASE_URL=https://YOUR_DOMAIN/api
# VITE_BACKEND_URL=https://YOUR_DOMAIN
